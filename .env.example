# AI RADAR — copy to .env and fill in (never commit .env)
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum importance score (0-100) that triggers a Telegram alert. Default 75.
TELEGRAM_MIN_SCORE=75
# Set to "true" to also send a daily-style digest of top events each run.
DAILY_DIGEST=false
# Optional: YouTube Data API key (V1 works WITHOUT it via channel RSS).
YOUTUBE_API_KEY=
# Optional: override the Gemini model (Flash-class = cheapest). Default: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
# Keep detailed events this many days (older pruned each run). Default: 90
RETENTION_DAYS=90
# Optional: GitHub token to raise rate limits (V1 works WITHOUT it).
GITHUB_TOKEN=
